<div
  id="map"
  class="h-96 bg-gray-100 rounded-xl border-gray-300 border-2 my-4"
  phx-hook="LeafletMap"
  phx-update="ignore"
  data-tooltip={@map_tooltip}
>
</div>

<section class="my-4">
  <h2 class="text-2xl">{gettext("Order history")}:</h2>
  <ul>
    <%= for change <- @resource.state_history do %>
      <li class="my-2 text-lg">
        <span class="text-gray-700">{date_to_string(change.inserted_at)}</span> - {change.comment}
      </li>
    <% end %>
  </ul>
</section>
