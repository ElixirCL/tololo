meta {
  name: update delivery state
  type: graphql
  seq: 4
}

post {
  url: 127.0.0.1:4000/gql
  body: graphql
  auth: none
}

body:graphql {
  mutation ($id: ID!, $input: UpdateStateInput!) {
    updateState(id: $id, input: $input) {
      result {
        id
        state
      }
      errors {
        code
        fields
        message
        shortMessage
        vars
      }
    }
  }
  
}

body:graphql:vars {
  {
    "id": "01948a19-c94f-7682-8949-d2ac0f6a9b81",
    "input": {
      "state": "In_Preparation"
    }
  }
}
