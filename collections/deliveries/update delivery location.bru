meta {
  name: update delivery location
  type: graphql
  seq: 3
}

post {
  url: {{gql_host}:{{gql_port}}/gql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer 01948a19-987d-7d52-b63e-b2d3e8ac8247
}

body:graphql {
  mutation ($id: ID!, $input: UpdateLocationInput!) {
    updateLocation(id: $id, input: $input) {
      result {
        id
        state
        fromLatitude
        fromLongitude
        toLatitude
        toLongitude
      }
      errors {
        code
        fields
        message
        shortMessage
        vars
      }
    }
  }
  
}

body:graphql:vars {
  {
    "id": "01948a19-c94f-7682-8949-d2ac0f6a9b81",
    "input": {
      "fromLatitude": 123,
      "fromLongitude": 321
    }
  }
}
