meta {
  name: update delivery state
  type: graphql
  seq: 4
}

post {
  url: {{gql_host}}:{{gql_port}}/gql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer 0194989c-4937-7d98-8dbf-97531da97189
}

body:graphql {
  mutation ($id: ID!, $input: UpdateStateInput!) {
    updateState(id: $id, input: $input) {
      result {
        id
        state
      }
      errors {
        code
        fields
        message
        shortMessage
        vars
      }
    }
  }
  
}

body:graphql:vars {
  {
    "id": "01949913-6016-76fa-8655-b5c056bfffcd",
    "input": {
      "state": "In_Preparation"
    }
  }
}
