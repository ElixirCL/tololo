meta {
  name: update delivery state
  type: graphql
  seq: 4
}

post {
  url: {{gql_host}}:{{gql_port}}/gql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer 0194a7e7-0231-711c-9d1a-2f945bd72dde
}

body:graphql {
  mutation ($id: ID!, $input: UpdateStateInput!) {
    updateState(id: $id, input: $input) {
      result {
        id
        state
      }
      errors {
        code
        fields
        message
        shortMessage
        vars
      }
    }
  }
  
}

body:graphql:vars {
  {
    "id": "0194a7e7-0231-707d-89f1-31eeca2b4a26",
    "input": {
      "state": "In_Preparation"
    }
  }
}
